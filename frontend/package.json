{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "fetch:voice-models": "node scripts/fetch-voice-models.mjs",
    "test:voice": "tsc -p tsconfig.voice.json && ln -sfn ../frontend/node_modules ../voice-test-dist/node_modules && NODE_PATH=./node_modules node --test ../voice-test-dist/voice/__tests__/audioInput.test.js ../voice-test-dist/voice/__tests__/audioLevel.test.js ../voice-test-dist/voice/__tests__/vocabulary.test.js ../voice-test-dist/voice/__tests__/stt.test.js ../voice-test-dist/voice/__tests__/voiceCapture.test.js ../voice-test-dist/voice/__tests__/voiceCircle.test.js ../voice-test-dist/voice/__tests__/voiceCopy.test.js ../voice-test-dist/voice/__tests__/inputCircle.test.js ../voice-test-dist/voice/__tests__/capture.integration.test.js ../voice-test-dist/voice/__tests__/micButton.test.js ../voice-test-dist/voice/__tests__/tts.test.js ../voice-test-dist/voice/__tests__/speechText.test.js ../voice-test-dist/voice/__tests__/voicePlayback.test.js ../voice-test-dist/voice/__tests__/voicePrefsStore.test.js ../voice-test-dist/voice/__tests__/voiceClipboard.test.js ../voice-test-dist/voice/__tests__/voiceTelemetryField.test.js ../voice-test-dist/voice/__tests__/voiceTrace.test.js ../voice-test-dist/voice/__tests__/synthesis.integration.test.js",
    "generate:mcp-catalog": "node scripts/generate-mcp-catalog.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@huggingface/transformers": "^4.3.0",
    "highlight.js": "^11.11.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
