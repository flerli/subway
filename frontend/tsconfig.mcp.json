{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022"],
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "../mcp-catalog-dist",
    "rootDir": "./src"
  },
  "include": [
    "src/widgets/*/mcpTools.ts",
    "src/widgets/widgetTypes.ts",
    "src/i18n/localization.ts",
    "src/i18n/appText.ts"
  ]
}